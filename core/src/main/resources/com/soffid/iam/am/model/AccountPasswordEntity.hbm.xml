<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.AccountPasswordEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_ACCPWD' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='APW_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='password' type='java.lang.String'>
			<column name='APW_PASSWD' not-null='false' length='255' />
		</property>
		<property name='password2' type='java.lang.String'>
			<column name='APW_PASSWD2' not-null='false' length='255' />
		</property>
		<property name='order' type='java.lang.Long'>
			<column name='APW_ORDER' not-null='true' />
		</property>
		<property name='date' type='java.util.Date'>
			<column name='APW_DATE' not-null='true' />
		</property>
		<property name='expirationDate' type='java.util.Date'>
			<column name='APW_EXPDAT' not-null='true' />
		</property>
		<property name='active' type='java.lang.String'>
			<column name='APW_ACTIVE' not-null='true' length='255' />
		</property>
		<many-to-one name='account' class='com.soffid.iam.base.model.AccountEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_ACCPWD_APW_ACC_ID'>
			<column name='APW_ACC_ID' not-null='true'/>
		</many-to-one>
		<property name='fails' type='java.lang.Integer'>
			<column name='APW_FAILS' not-null='false' />
		</property>
		<property name='unlockDate' type='java.util.Date'>
			<column name='APW_UNLOCK' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
