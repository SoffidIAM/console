<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.ChallengeEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_CHALLE' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='CHA_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='type' type='int'>
			<column name='CHA_TYPE' not-null='true' />
		</property>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CHALLE_CHA_USU_ID'>
			<column name='CHA_USU_ID' not-null='false'/>
		</many-to-one>
		<many-to-one name='account' class='com.soffid.iam.base.model.AccountEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CHALLE_CHA_ACC_ID'>
			<column name='CHA_ACC_ID' not-null='false'/>
		</many-to-one>
		<property name='userKey' type='java.lang.String'>
			<column name='CHA_USEKEY' not-null='false' length='100' />
		</property>
		<many-to-one name='host' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CHALLE_CHA_MAQ_ID'>
			<column name='CHA_MAQ_ID' not-null='false'/>
		</many-to-one>
		<many-to-one name='clientHost' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CHALLE_CHA_CL_MAQ_ID'>
			<column name='CHA_CL_MAQ_ID' not-null='false'/>
		</many-to-one>
		<property name='centinelPort' type='java.lang.Integer'>
			<column name='CHA_CENTINEL' not-null='false' />
		</property>
		<property name='otpHandler' type='java.lang.String'>
			<column name='CHA_OTPHAN' not-null='false' />
		</property>
		<property name='cardNumber' type='java.lang.String'>
			<column name='CHA_CARNUM' not-null='false' />
		</property>
		<property name='cell' type='java.lang.String'>
			<column name='CHA_CELL' not-null='false' />
		</property>
		<property name='value' type='java.lang.String'>
			<column name='CHA_VALUE' not-null='false' />
		</property>
		<property name='timeStamp' type='java.util.Date'>
			<column name='CHA_DATE' not-null='false' />
		</property>
		<property name='clientVersion' type='java.lang.Integer'>
			<column name='CHA_CLIVER' not-null='false' />
		</property>
		<property name='kerberosDomain' type='java.lang.String'>
			<column name='CHA_KERBER' not-null='false' />
		</property>
		<property name='challengeId' type='java.lang.String'>
			<column name='CHA_CHAID' not-null='false' />
		</property>
		<property name='domain' type='java.lang.String'>
			<column name='CHA_DOMAIN' not-null='false' length='100' />
		</property>
		<property name='closeOldSessions' type='boolean'>
			<column name='CHA_CLOSES' not-null='true' />
		</property>
		<property name='silent' type='boolean'>
			<column name='CHA_SILENT' not-null='true' />
		</property>
		<property name='identityProvider' type='java.lang.String'>
			<column name='CHA_IDP' not-null='false' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CHALLE_CHA_TEN_ID'>
			<column name='CHA_TEN_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
