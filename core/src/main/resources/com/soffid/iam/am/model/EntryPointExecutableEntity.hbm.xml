<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.EntryPointExecutableEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_EXEPUE' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='EPE_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='scope' type='java.lang.String'>
			<column name='EPE_AMBIT' not-null='true' length='1' />
		</property>
		<property name='content' type='java.lang.String'>
			<column name='EPE_CONTIN' not-null='false' length='4000' />
		</property>
		<many-to-one name='entryPoint' class='com.soffid.iam.am.model.EntryPointEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_EXEPUE_EPE_IDPUE'>
			<column name='EPE_IDPUE' not-null='true'/>
		</many-to-one>
		<property name='executionCode' type='java.lang.String'>
			<column name='EPE_CODEXE' not-null='false' length='10' />
		</property>
	</class>
</hibernate-mapping>
