<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.EntryPointIconEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_ICONES' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='ICO_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='icon' type='org.springframework.orm.hibernate3.support.BlobByteArrayType' lazy='true'>
			<column name='ICO_ICONA' not-null='true' length='20000' />
		</property>
	</class>
</hibernate-mapping>
