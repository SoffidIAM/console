<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.EntryPointRoleEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_ROLPUE' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='RPE_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='entryPoint' class='com.soffid.iam.am.model.EntryPointEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_ROLPUE_RPE_IDPUE'>
			<column name='RPE_IDPUE' not-null='true'/>
		</many-to-one>
		<property name='authorizationLevel' type='java.lang.String'>
			<column name='RPE_NIVAUT' not-null='true' length='1' />
		</property>
		<many-to-one name='role' class='com.soffid.iam.iga.model.RoleEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_ROLPUE_RPE_IDROL'>
			<column name='RPE_IDROL' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
