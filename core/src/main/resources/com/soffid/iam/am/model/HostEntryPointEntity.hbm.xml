<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.HostEntryPointEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_MAQPUE' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='MAP_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='host' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_MAQPUE_MAP_MAQ_ID'>
			<column name='MAP_MAQ_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='entryPoint' class='com.soffid.iam.am.model.EntryPointEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_MAQPUE_MAP_PUE_ID'>
			<column name='MAP_PUE_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
