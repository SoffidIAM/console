<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.NetworkAuthorizationEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_AUTXAR' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='AXA_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='level' type='java.lang.Integer'>
			<column name='AXA_NIVELL' not-null='true' />
		</property>
		<property name='hostsName' type='java.lang.String'>
			<column name='AXA_MASMAQ' not-null='false' length='50' />
		</property>
		<many-to-one name='network' class='com.soffid.iam.am.model.NetworkEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_AUTXAR_AXA_IDXAR'>
			<column name='AXA_IDXAR' not-null='true'/>
		</many-to-one>
		<many-to-one name='role' class='com.soffid.iam.iga.model.RoleEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_AUTXAR_AXA_IDROL'>
			<column name='AXA_IDROL' not-null='false'/>
		</many-to-one>
		<many-to-one name='group' class='com.soffid.iam.iga.model.GroupEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_AUTXAR_AXA_IDGRU'>
			<column name='AXA_IDGRU' not-null='false'/>
		</many-to-one>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_AUTXAR_AXA_IDUSU'>
			<column name='AXA_IDUSU' not-null='false'/>
		</many-to-one>
	</class>
</hibernate-mapping>
