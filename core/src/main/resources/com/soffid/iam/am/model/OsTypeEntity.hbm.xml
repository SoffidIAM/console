<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.OsTypeEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_OSTYPE' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='OST_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='name' type='java.lang.String'>
			<column name='OST_NAME' not-null='true' length='20' />
		</property>
		<property name='description' type='java.lang.String'>
			<column name='OST_DESC' not-null='false' length='50' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_OSTYPE_OST_TEN_ID'>
			<column name='OST_TEN_ID' not-null='true'/>
		</many-to-one>
		<set name='operatingSystemHost' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_MAQUIN_MAQ_OST_ID'>
				<column name='MAQ_OST_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.am.model.HostEntityImpl'/>
		</set>
	</class>
</hibernate-mapping>
