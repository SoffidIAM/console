<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.PasswordDomainEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_DOMCON' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='DCN_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='name' type='java.lang.String'>
			<column name='DCN_CODI' not-null='true' length='50' />
		</property>
		<property name='description' type='java.lang.String'>
			<column name='DCN_DESC' not-null='false' length='100' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_DOMCON_DCN_TEN_ID'>
			<column name='DCN_TEN_ID' not-null='true'/>
		</many-to-one>
		<set name='passwordPolicies' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_POCODO_PCD_DCN_ID'>
				<column name='PCD_DCN_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.am.model.PasswordPolicyEntityImpl'/>
		</set>
		<set name='systems' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_DISPAT_DIS_DCN_ID'>
				<column name='DIS_DCN_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.SystemEntityImpl'/>
		</set>
	</class>
</hibernate-mapping>
