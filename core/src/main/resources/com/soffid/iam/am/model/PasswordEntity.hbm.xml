<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.PasswordEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_CONTRA' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='CTR_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='password' type='java.lang.String'>
			<column name='CTR_CONTRA' not-null='false' length='50' />
		</property>
		<property name='password2' type='java.lang.String'>
			<column name='CTR_PASSWD' not-null='false' length='150' />
		</property>
		<property name='active' type='java.lang.String'>
			<column name='CTR_ACTIU' not-null='false' length='1' />
		</property>
		<property name='order' type='java.lang.Long'>
			<column name='CTR_ORDRE' not-null='true' />
		</property>
		<property name='date' type='java.util.Date'>
			<column name='CTR_DATA' not-null='false' />
		</property>
		<property name='expirationDate' type='java.util.Date'>
			<column name='CTR_DATCAD' not-null='false' />
		</property>
		<many-to-one name='domain' class='com.soffid.iam.am.model.PasswordDomainEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CONTRA_CTR_DCN_ID'>
			<column name='CTR_DCN_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CONTRA_CTR_IDUSU'>
			<column name='CTR_IDUSU' not-null='true'/>
		</many-to-one>
		<property name='fails' type='java.lang.Integer'>
			<column name='CTR_FAILS' not-null='false' />
		</property>
		<property name='unlockDate' type='java.util.Date'>
			<column name='CTR_UNLOCK' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
