<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.PasswordManagerTokenEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_PAMATO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='PMT_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_PAMATO_PMT_USU_ID'>
			<column name='PMT_USU_ID' not-null='true'/>
		</many-to-one>
		<property name='created' type='java.util.Date'>
			<column name='PMT_CREATE' not-null='true' />
		</property>
		<property name='expires' type='java.util.Date'>
			<column name='PMT_EXPIRE' not-null='true' />
		</property>
		<property name='renew' type='java.util.Date'>
			<column name='PMT_RENEW' not-null='true' />
		</property>
		<property name='token' type='java.lang.String'>
			<column name='PMT_TOKEN' not-null='true' length='256' />
		</property>
		<property name='oldToken' type='java.lang.String'>
			<column name='PMT_OLDTOK' not-null='false' length='256' />
		</property>
	</class>
</hibernate-mapping>
