<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.PasswordPolicyEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_POCODO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='PCD_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='description' type='java.lang.String'>
			<column name='PCD_DESC' not-null='false' length='100' />
		</property>
		<many-to-one name='userType' class='com.soffid.iam.base.model.UserTypeEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_POCODO_PCD_TUS_ID'>
			<column name='PCD_TUS_ID' not-null='true'/>
		</many-to-one>
		<property name='type' type='java.lang.String'>
			<column name='PCD_TIPUS' not-null='true' length='1' />
		</property>
		<property name='renewalTime' type='java.lang.Long'>
			<column name='PCD_RENAGE' not-null='false' />
		</property>
		<property name='maximumPeriod' type='java.lang.Long'>
			<column name='PCD_AGE' not-null='false' />
		</property>
		<property name='maximumPeriodExpired' type='java.lang.Long'>
			<column name='PCD_GRACE' not-null='false' />
		</property>
		<property name='minimumPeriod' type='java.lang.Long'>
			<column name='PCD_MINAGE' not-null='false' />
		</property>
		<property name='minimumLength' type='java.lang.Long'>
			<column name='PCD_MINLEN' not-null='false' />
		</property>
		<property name='maximumLength' type='java.lang.Long'>
			<column name='PCD_MAXLEN' not-null='false' />
		</property>
		<property name='regularExpression' type='java.lang.String'>
			<column name='PCD_REGEX' not-null='false' length='100' />
		</property>
		<property name='minimumUppercase' type='java.lang.Long'>
			<column name='PCD_MINUPP' not-null='false' />
		</property>
		<property name='maximumUppercase' type='java.lang.Long'>
			<column name='PCD_MAXUPP' not-null='false' />
		</property>
		<property name='minimumLowercase' type='java.lang.Long'>
			<column name='PCD_MINLOW' not-null='false' />
		</property>
		<property name='maximumLowercase' type='java.lang.Long'>
			<column name='PCD_MAXLOW' not-null='false' />
		</property>
		<property name='minimumNumbers' type='java.lang.Long'>
			<column name='PCD_MINNUM' not-null='false' />
		</property>
		<property name='maximumNumbers' type='java.lang.Long'>
			<column name='PCD_MAXNUM' not-null='false' />
		</property>
		<property name='minimumSymbols' type='java.lang.Long'>
			<column name='PCD_MINPUN' not-null='false' />
		</property>
		<property name='maximumSymbols' type='java.lang.Long'>
			<column name='PCD_MAXPUN' not-null='false' />
		</property>
		<property name='maximumHistorical' type='java.lang.Long'>
			<column name='PCD_MAXHIST' not-null='false' />
		</property>
		<many-to-one name='passwordDomain' class='com.soffid.iam.am.model.PasswordDomainEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_POCODO_PCD_DCN_ID'>
			<column name='PCD_DCN_ID' not-null='false'/>
		</many-to-one>
		<set name='forbiddenWords' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_BADCON_BDC_PCD_ID'>
				<column name='BDC_PCD_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.am.model.PolicyForbiddenWordEntityImpl'/>
		</set>
		<property name='allowPasswordQuery' type='java.lang.Boolean'>
			<column name='PCD_PASQRY' not-null='false' />
		</property>
		<property name='allowPasswordChange' type='java.lang.Boolean'>
			<column name='PCD_PASCHG' not-null='false' />
		</property>
		<property name='complexPasswords' type='java.lang.Boolean'>
			<column name='PCD_COMPLEX' not-null='true' />
		</property>
		<property name='maxFailures' type='java.lang.Integer'>
			<column name='PCD_MAXFAI' not-null='false' />
		</property>
		<property name='unlockAfterSeconds' type='java.lang.Integer'>
			<column name='PCD_UNLSEC' not-null='false' />
		</property>
		<property name='validationScript' type='java.lang.String' lazy='true'>
			<column name='PCD_PACHSC' not-null='false' length='5000' />
		</property>
		<property name='validationScriptDescription' type='java.lang.String'>
			<column name='PCD_PACHDE' not-null='false' />
		</property>
		<property name='checkPasswordBreached' type='java.lang.Boolean'>
			<column name='PCD_BREACH' not-null='true' />
		</property>
	</class>
</hibernate-mapping>
