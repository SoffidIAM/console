<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.SamlAssertionEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_SAMLASS' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='ASS_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='externalId' type='java.lang.String'>
			<column name='ASS_EXTID' not-null='true' />
		</property>
		<property name='date' type='java.util.Date'>
			<column name='ASS_DATE' not-null='true' />
		</property>
		<property name='issuer' type='java.lang.String'>
			<column name='ASS_ISSUER' not-null='true' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SAMLASS_ASS_TEN_ID'>
			<column name='ASS_TEN_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
