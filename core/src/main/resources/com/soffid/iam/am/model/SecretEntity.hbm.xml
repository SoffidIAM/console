<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.SecretEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_SECRET' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='SEC_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='server' class='com.soffid.iam.sync.model.ServerEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SECRET_SEC_IDSRV'>
			<column name='SEC_IDSRV' not-null='true'/>
		</many-to-one>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SECRET_SEC_IDUSU'>
			<column name='SEC_IDUSU' not-null='true'/>
		</many-to-one>
		<property name='secrets' type='org.springframework.orm.hibernate3.support.BlobByteArrayType' lazy='true'>
			<column name='SEC_VALOR' not-null='true' length='64000' />
		</property>
	</class>
</hibernate-mapping>
