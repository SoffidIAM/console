<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.am.model.SessionEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_SESSIO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='SES_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='port' type='java.lang.Long'>
			<column name='SES_PORT' not-null='false' />
		</property>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SESSIO_SES_IDUSU'>
			<column name='SES_IDUSU' not-null='true'/>
		</many-to-one>
		<many-to-one name='account' class='com.soffid.iam.base.model.AccountEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SESSIO_SES_ACC_ID'>
			<column name='SES_ACC_ID' not-null='false'/>
		</many-to-one>
		<many-to-one name='clientHost' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SESSIO_SES_IDMACL'>
			<column name='SES_IDMACL' not-null='false'/>
		</many-to-one>
		<many-to-one name='host' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SESSIO_SES_IDMAQ'>
			<column name='SES_IDMAQ' not-null='false'/>
		</many-to-one>
		<many-to-one name='browser' class='com.soffid.iam.am.model.BrowserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SESSIO_SES_IDBRO'>
			<column name='SES_IDBRO' not-null='false'/>
		</many-to-one>
		<property name='startDate' type='java.util.Date'>
			<column name='SES_DATA' not-null='true' />
		</property>
		<property name='keepAliveDate' type='java.util.Date'>
			<column name='SES_DAKEAL' not-null='false' />
		</property>
		<property name='externalClientIp' type='java.lang.String'>
			<column name='SES_EXCLIP' not-null='false' length='60' />
		</property>
		<property name='newKey' type='java.lang.String'>
			<column name='SES_KEY2' not-null='false' length='50' />
		</property>
		<property name='type' type='com.soffid.iam.am.api.SessionTypeEnum'>
			<column name='SES_TIPUS' not-null='false' />
		</property>
		<property name='webHandler' type='java.lang.String'>
			<column name='SES_WEBURL' not-null='false' length='4000' />
		</property>
		<property name='key' type='java.lang.String'>
			<column name='SES_KEY' not-null='false' length='50' />
		</property>
		<many-to-one name='loginLogInfo' class='com.soffid.iam.am.model.AccessLogEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SESSIO_SES_IDRAC'>
			<column name='SES_IDRAC' not-null='false'/>
		</many-to-one>
		<property name='clientAddress' type='java.lang.String'>
			<column name='SES_CLIADR' not-null='false' length='128' />
		</property>
		<property name='clientHostName' type='java.lang.String'>
			<column name='SES_CLINAM' not-null='false' length='128' />
		</property>
		<property name='hostName' type='java.lang.String'>
			<column name='SES_HOSNAM' not-null='false' length='128' />
		</property>
		<property name='hostAddress' type='java.lang.String'>
			<column name='SES_HOSADR' not-null='false' length='128' />
		</property>
		<property name='authenticationMethod' type='java.lang.String'>
			<column name='SES_AUTHMT' not-null='false' length='4' />
		</property>
		<property name='monitorUrl' type='java.lang.String'>
			<column name='SES_MONURL' not-null='false' length='150' />
		</property>
		<property name='justInTimePermissionToRemove' type='java.lang.String'>
			<column name='SES_JITTR' not-null='false' length='2000' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SESSIO_SES_TEN_ID'>
			<column name='SES_TEN_ID' not-null='false'/>
		</many-to-one>
		<property name='serviceProvider' type='java.lang.String'>
			<column name='SES_SERPRO' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
