<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.AccountAttributeEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_ACCATT' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='AAT_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='value' type='java.lang.String'>
			<column name='AAT_VALOR' not-null='false' length='1024' />
		</property>
		<many-to-one name='account' class='com.soffid.iam.base.model.AccountEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_ACCATT_AAT_ACC_ID'>
			<column name='AAT_ACC_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='systemMetadata' class='com.soffid.iam.base.model.AccountMetadataEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_ACCATT_AAT_AME_ID'>
			<column name='AAT_AME_ID' not-null='false'/>
		</many-to-one>
		<many-to-one name='metadata' class='com.soffid.iam.iga.model.MetaDataEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_ACCATT_AAT_TDA_ID'>
			<column name='AAT_TDA_ID' not-null='false'/>
		</many-to-one>
		<property name='blobDataValue' type='java.sql.Blob' lazy='true'>
			<column name='AAT_BLOB' not-null='false' length='400000' />
		</property>
	</class>
</hibernate-mapping>
