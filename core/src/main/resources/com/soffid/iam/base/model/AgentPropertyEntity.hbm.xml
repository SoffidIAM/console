<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.AgentPropertyEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_AGEPRO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='APR_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='template' type='java.lang.String'>
			<column name='APR_TEMPLA' not-null='true' length='50' />
		</property>
		<property name='type' type='java.lang.String'>
			<column name='APR_TYPE' not-null='true' length='250' />
		</property>
		<many-to-one name='agent' class='com.soffid.iam.base.model.AgentDescriptorEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_AGEPRO_APR_ADE_ID'>
			<column name='APR_ADE_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
