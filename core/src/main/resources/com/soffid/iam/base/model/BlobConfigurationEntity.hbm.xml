<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.BlobConfigurationEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_BLOCON' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='BCO_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='name' type='java.lang.String'>
			<column name='BCO_NAME' not-null='true' length='255' />
		</property>
		<property name='value' type='java.sql.Blob' lazy='true'>
			<column name='BCO_VALUE' not-null='true' length='10240000' />
		</property>
		<property name='version' type='java.lang.String'>
			<column name='BCO_VERSIO' not-null='false' length='50' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_BLOCON_BCO_TEN_ID'>
			<column name='BCO_TEN_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
