<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.DefaultAttributeMappingEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_DEATMA' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='DAM_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='soffidAttribute' type='java.lang.String'>
			<column name='DAM_SOFATR' not-null='true' length='1000' />
		</property>
		<property name='systemAttribute' type='java.lang.String'>
			<column name='DAM_SYSATR' not-null='true' length='1000' />
		</property>
		<property name='direction' type='com.soffid.iam.iga.api.AttributeDirectionEnum'>
			<column name='DAM_DIRECT' not-null='true' length='2' />
		</property>
		<many-to-one name='defaultObjectMapping' class='com.soffid.iam.base.model.DefaultObjectMappingEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_DEATMA_DAM_DOM_ID'>
			<column name='DAM_DOM_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
