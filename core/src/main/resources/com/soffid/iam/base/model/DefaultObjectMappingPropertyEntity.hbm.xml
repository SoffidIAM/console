<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.DefaultObjectMappingPropertyEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_DEOBPR' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='DOP_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='property' type='java.lang.String'>
			<column name='DOP_PROPER' not-null='true' length='50' />
		</property>
		<property name='value' type='java.lang.String'>
			<column name='DOP_VALUE' not-null='true' length='250' />
		</property>
		<many-to-one name='object' class='com.soffid.iam.base.model.DefaultObjectMappingEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_DEOBPR_DOP_DOM_ID'>
			<column name='DOP_DOM_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
