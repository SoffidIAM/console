<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.LuceneIndexEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_LUNIND' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='LIP_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='name' type='java.lang.String'>
			<column name='LIP_NAME' not-null='true' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_LUNIND_LIP_TEN_ID'>
			<column name='LIP_TEN_ID' not-null='true'/>
		</many-to-one>
		<property name='timestamp' type='long'>
			<column name='LIP_TIMSTA' not-null='true' />
		</property>
		<set name='parts' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_LUINPA_LIP_LIN_ID'>
				<column name='LIP_LIN_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.base.model.LuceneIndexPartEntityImpl'/>
		</set>
	</class>
</hibernate-mapping>
