<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.LuceneIndexPartEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_LUINPA' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='LIP_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='index' class='com.soffid.iam.base.model.LuceneIndexEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_LUINPA_LIP_LIN_ID'>
			<column name='LIP_LIN_ID' not-null='true'/>
		</many-to-one>
		<property name='name' type='java.lang.String'>
			<column name='LIP_NAME' not-null='true' length='256' />
		</property>
		<property name='order' type='int'>
			<column name='LIP_ORDER' not-null='true' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_LUINPA_LIP_TEN_ID'>
			<column name='LIP_TEN_ID' not-null='true'/>
		</many-to-one>
		<property name='data' type='org.springframework.orm.hibernate3.support.BlobByteArrayType' lazy='true'>
			<column name='LIP_DATA' not-null='false' length='256000' />
		</property>
		<property name='timestamp' type='java.lang.Long'>
			<column name='LIP_TIMSTA' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
