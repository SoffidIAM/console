<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.ServerPluginModuleEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_SEPLMO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='SPM_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='name' type='java.lang.String'>
			<column name='SPM_NAME' not-null='true' length='255' />
		</property>
		<property name='contents' type='java.sql.Blob' lazy='true'>
			<column name='SPM_DATA' not-null='true' length='40000000' />
		</property>
		<property name='type' type='com.soffid.iam.base.api.ServerPluginModuleTypeEnum'>
			<column name='SPM_TYPE' not-null='true' length='255' />
		</property>
		<many-to-one name='plugin' class='com.soffid.iam.base.model.ServerPluginEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SEPLMO_SPM_SPL_ID'>
			<column name='SPM_SPL_ID' not-null='true'/>
		</many-to-one>
		<set name='agents' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_AGEDES_ADE_SPM_ID'>
				<column name='ADE_SPM_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.base.model.AgentDescriptorEntityImpl'/>
		</set>
		<property name='initClass' type='java.lang.String'>
			<column name='SPM_CLASS' not-null='false' length='255' />
		</property>
		<property name='resourceName' type='java.lang.String'>
			<column name='SPM_RESNAM' not-null='false' length='255' />
		</property>
	</class>
</hibernate-mapping>
