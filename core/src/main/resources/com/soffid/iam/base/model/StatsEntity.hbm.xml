<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.StatsEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_STATS' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='STA_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='name' type='java.lang.String'>
			<column name='STA_NAME' not-null='true' length='256' />
		</property>
		<property name='date' type='java.lang.String'>
			<column name='STA_DATE' not-null='true' length='16' />
		</property>
		<property name='serie' type='java.lang.String'>
			<column name='STA_SERIE' not-null='false' length='128' />
		</property>
		<property name='value' type='java.lang.Long'>
			<column name='STA_VALUE' not-null='false' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_STATS_STA_TEN_ID'>
			<column name='STA_TEN_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
