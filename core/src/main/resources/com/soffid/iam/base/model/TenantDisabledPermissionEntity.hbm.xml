<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.TenantDisabledPermissionEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_TEDIPE' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='TDP_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='appliesTo' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_TEDIPE_TDP_TEN_ID'>
			<column name='TDP_TEN_ID' not-null='true'/>
		</many-to-one>
		<property name='permission' type='java.lang.String'>
			<column name='TDP_PERMISSION' not-null='true' />
		</property>
	</class>
</hibernate-mapping>
