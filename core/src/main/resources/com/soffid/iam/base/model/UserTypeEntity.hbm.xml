<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.base.model.UserTypeEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_TIPUSU' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='TUS_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='name' type='java.lang.String'>
			<column name='TUS_CODI' not-null='true' length='10' />
		</property>
		<property name='description' type='java.lang.String'>
			<column name='TUS_DESC' not-null='false' length='50' />
		</property>
		<property name='managed' type='java.lang.Boolean'>
			<column name='TUS_MANAGE' not-null='false' length='50' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_TIPUSU_TUS_TEN_ID'>
			<column name='TUS_TEN_ID' not-null='true'/>
		</many-to-one>
		<set name='policies' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_POCODO_PCD_TUS_ID'>
				<column name='PCD_TUS_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.am.model.PasswordPolicyEntityImpl'/>
		</set>
		<set name='accounts' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_ACCOUN_ACC_TUS_ID'>
				<column name='ACC_TUS_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.base.model.AccountEntityImpl'/>
		</set>
		<property name='createdOn' type='java.util.Date'>
			<column name='TUS_CREDAT' not-null='false' />
		</property>
		<property name='createdBy' type='java.lang.String'>
			<column name='TUS_CREUSE' not-null='false' />
		</property>
		<property name='updatedOn' type='java.util.Date'>
			<column name='TUS_UPDDAT' not-null='false' />
		</property>
		<property name='updatedBy' type='java.lang.String'>
			<column name='TUS_UPDUSE' not-null='false' />
		</property>
		<property name='deletedOn' type='java.util.Date'>
			<column name='TUS_DELDAT' not-null='false' />
		</property>
		<property name='deletedBy' type='java.lang.String'>
			<column name='TUS_DELUSE' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
