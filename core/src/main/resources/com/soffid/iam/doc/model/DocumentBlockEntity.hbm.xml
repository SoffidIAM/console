<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.doc.model.DocumentBlockEntityImpl' dynamic-insert='false' dynamic-update='false' table='BPM_DOCBLO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='DBL_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='path' type='java.lang.String'>
			<column name='DBL_PATH' not-null='true' />
		</property>
		<property name='sequenceNumber' type='java.lang.Long'>
			<column name='DBL_SEQNUM' not-null='true' />
		</property>
		<property name='content' type='org.springframework.orm.hibernate3.support.BlobByteArrayType' lazy='true'>
			<column name='DBL_CONTENT' not-null='false' length='16384' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='BPM_DOCBLO_DBL_TEN_ID'>
			<column name='DBL_TEN_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
