<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.doc.model.FileSystemImpl' dynamic-insert='false' dynamic-update='false' table='BPM_FILE_SYSTEM' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='FIL_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='application' type='java.lang.String'>
			<column name='FIL_APPLICATION' not-null='true' length='64' />
		</property>
		<property name='year' type='java.lang.Integer'>
			<column name='FIL_YEAR' not-null='true' />
		</property>
		<property name='nextDocNumber' type='java.lang.Long'>
			<column name='FIL_NEXT_DOC' not-null='true' />
		</property>
	</class>
</hibernate-mapping>
