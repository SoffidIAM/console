<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.CustomObjectEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_CUSOBJ' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='COB_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='name' type='java.lang.String'>
			<column name='COB_NAME' not-null='true' />
		</property>
		<property name='description' type='java.lang.String'>
			<column name='COB_DESCR' not-null='true' length='250' />
		</property>
		<many-to-one name='type' class='com.soffid.iam.iga.model.CustomObjectTypeEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CUSOBJ_COB_COT_ID'>
			<column name='COB_COT_ID' not-null='true'/>
		</many-to-one>
		<set name='attributes' lazy='true' fetch='select' inverse='true' cascade='all,delete-orphan'>
			<key foreign-key='SC_COBATT_COA_COB_ID'>
				<column name='COA_COB_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.CustomObjectAttributeEntityImpl'/>
		</set>
		<property name='createdOn' type='java.util.Date'>
			<column name='COB_CREDAT' not-null='false' />
		</property>
		<property name='createdBy' type='java.lang.String'>
			<column name='COB_CREUSE' not-null='false' />
		</property>
		<property name='updatedOn' type='java.util.Date'>
			<column name='COB_UPDDAT' not-null='false' />
		</property>
		<property name='updatedBy' type='java.lang.String'>
			<column name='COB_UPDUSE' not-null='false' />
		</property>
		<property name='deletedOn' type='java.util.Date'>
			<column name='COB_DELDAT' not-null='false' />
		</property>
		<property name='deletedBy' type='java.lang.String'>
			<column name='COB_DELUSE' not-null='false' />
		</property>
		<property name='deleted' type='java.lang.Boolean'>
			<column name='COB_DELETED' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
