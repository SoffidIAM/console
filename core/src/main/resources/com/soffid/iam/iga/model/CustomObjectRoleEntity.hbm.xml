<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.CustomObjectRoleEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_CUSBRO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='COR_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='customObjectType' class='com.soffid.iam.iga.model.CustomObjectTypeEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CUSBRO_COR_COT_ID'>
			<column name='COR_COT_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='role' class='com.soffid.iam.iga.model.RoleEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_CUSBRO_COR_ROL_ID'>
			<column name='COR_ROL_ID' not-null='true'/>
		</many-to-one>
		<property name='level' type='com.soffid.iam.base.api.AccountAccessLevelEnumEnum'>
			<column name='COR_LEVEL' not-null='true' />
		</property>
	</class>
</hibernate-mapping>
