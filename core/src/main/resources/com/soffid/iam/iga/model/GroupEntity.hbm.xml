<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.GroupEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_GRUPS' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='GRU_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='name' type='java.lang.String'>
			<column name='GRU_CODI' not-null='true' length='150' />
		</property>
		<property name='description' type='java.lang.String'>
			<column name='GRU_DESCRI' not-null='false' length='250' />
		</property>
		<property name='quota' type='java.lang.Long'>
			<column name='GRU_QUOTA' not-null='false' />
		</property>
		<property name='driveLetter' type='java.lang.String'>
			<column name='GRU_UNIOFI' not-null='false' length='2' />
		</property>
		<many-to-one name='parent' class='com.soffid.iam.iga.model.GroupEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_GRUPS_GRU_PARE'>
			<column name='GRU_PARE' not-null='false'/>
		</many-to-one>
		<set name='printers' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_GRUIMP_GIM_IDGRU'>
				<column name='GIM_IDGRU'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.PrinterGroupEntityImpl'/>
		</set>
		<set name='secondaryGroupUsers' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_USUGRU_UGR_IDGRU'>
				<column name='UGR_IDGRU'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.UserGroupEntityImpl'/>
		</set>
		<many-to-one name='driveServer' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_GRUPS_GRU_IDMAQ'>
			<column name='GRU_IDMAQ' not-null='false'/>
		</many-to-one>
		<set name='networkAuthorization' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_AUTXAR_AXA_IDGRU'>
				<column name='AXA_IDGRU'/>
			</key>
			<one-to-many class='com.soffid.iam.am.model.NetworkAuthorizationEntityImpl'/>
		</set>
		<set name='children' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_GRUPS_GRU_PARE'>
				<column name='GRU_PARE'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.GroupEntityImpl'/>
		</set>
		<set name='usersRoles' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_ROLUSU_RLU_ROLUSU_GRU'>
				<column name='RLU_ROLUSU_GRU'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.RoleAccountEntityImpl'/>
		</set>
		<many-to-one name='unitType' class='com.soffid.iam.iga.model.GroupTypeEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_GRUPS_GRU_TIPUS'>
			<column name='GRU_TIPUS' not-null='false'/>
		</many-to-one>
		<property name='obsolete' type='java.lang.Boolean'>
			<column name='GRU_ISOLD' not-null='true' length='5' />
		</property>
		<property name='startDate' type='java.util.Date'>
			<column name='GRU_STADAT' not-null='false' />
		</property>
		<property name='endDate' type='java.util.Date'>
			<column name='GRU_ENDDAT' not-null='false' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_GRUPS_GRU_TEN_ID'>
			<column name='GRU_TEN_ID' not-null='true'/>
		</many-to-one>
		<set name='systemGroup' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_GRUDIS_GRD_IDGRUP'>
				<column name='GRD_IDGRUP'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.SystemGroupEntityImpl'/>
		</set>
		<set name='grantedRoles' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_ROLGRUP_RLG_GRUP'>
				<column name='RLG_GRUP'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.RoleGroupEntityImpl'/>
		</set>
		<set name='primaryGroupUsers' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_USUARI_USU_IDGRU'>
				<column name='USU_IDGRU'/>
			</key>
			<one-to-many class='com.soffid.iam.base.model.UserEntityImpl'/>
		</set>
		<set name='accountAccess' lazy='true' fetch='select' inverse='true' cascade='all,delete-orphan'>
			<key foreign-key='SC_ACCACC_AAC_GRU_ID'>
				<column name='AAC_GRU_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.pam.model.AccountAccessEntityImpl'/>
		</set>
		<set name='holdedRoleAssignments' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_ROLUSU_RLU_GROUP'>
				<column name='RLU_GROUP'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.RoleAccountEntityImpl'/>
		</set>
		<set name='attributes' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_GRUATT_GAT_GRU_ID'>
				<column name='GAT_GRU_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.GroupAttributeEntityImpl'/>
		</set>
		<set name='mailLists' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_LCOGRU_LCR_GRU_ID'>
				<column name='LCR_GRU_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.MailListGroupMemberEntityImpl'/>
		</set>
		<set name='roleScopeMailLists' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_LCOROL_LCR_GRU_ID'>
				<column name='LCR_GRU_ID'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.MailListRoleMemberEntityImpl'/>
		</set>
		<set name='audit' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_AUDITO_AUD_IDGRU'>
				<column name='AUD_IDGRU'/>
			</key>
			<one-to-many class='com.soffid.iam.rc.model.AuditEntityImpl'/>
		</set>
		<property name='createdOn' type='java.util.Date'>
			<column name='GRU_CREDAT' not-null='false' />
		</property>
		<property name='createdBy' type='java.lang.String'>
			<column name='GRU_CREUSE' not-null='false' />
		</property>
		<property name='updatedOn' type='java.util.Date'>
			<column name='GRU_UPDDAT' not-null='false' />
		</property>
		<property name='updatedBy' type='java.lang.String'>
			<column name='GRU_UPDUSE' not-null='false' />
		</property>
		<property name='deletedOn' type='java.util.Date'>
			<column name='GRU_DELDAT' not-null='false' />
		</property>
		<property name='deletedBy' type='java.lang.String'>
			<column name='GRU_DELUSE' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
