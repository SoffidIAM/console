<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.HostAliasEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_MAQUINALIAS' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='MAL_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='alias' type='java.lang.String'>
			<column name='MAL_ALIAS' not-null='true' length='2048' />
		</property>
		<many-to-one name='host' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_MAQUINALIAS_MAL_MAQID'>
			<column name='MAL_MAQID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
