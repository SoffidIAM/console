<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.MailListContainerEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_LCOLCO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='LLC_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='contains' class='com.soffid.iam.iga.model.MailListEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_LCOLCO_LLC_IDLCO1'>
			<column name='LLC_IDLCO1' not-null='true'/>
		</many-to-one>
		<many-to-one name='pertains' class='com.soffid.iam.iga.model.MailListEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_LCOLCO_LLC_IDLCO2'>
			<column name='LLC_IDLCO2' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
