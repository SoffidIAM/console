<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.MailListGroupMemberEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_LCOGRU' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='LCG_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='mailList' class='com.soffid.iam.iga.model.MailListEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_LCOGRU_LCG_LCO_ID'>
			<column name='LCG_LCO_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='group' class='com.soffid.iam.iga.model.GroupEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_LCOGRU_LCR_GRU_ID'>
			<column name='LCR_GRU_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
