<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.ObjectMappingPropertyEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_OBMAPR' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='OMP_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='property' type='java.lang.String'>
			<column name='OMP_PROPER' not-null='true' length='50' />
		</property>
		<property name='value' type='java.lang.String'>
			<column name='OMP_VALUE' not-null='true' length='3500' />
		</property>
		<many-to-one name='object' class='com.soffid.iam.iga.model.ObjectMappingEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_OBMAPR_OMP_OBM_ID'>
			<column name='OMP_OBM_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
