<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.PrinterEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_IMPRES' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='IMP_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='model' type='java.lang.String'>
			<column name='IMP_MODEL' not-null='false' length='50' />
		</property>
		<property name='name' type='java.lang.String'>
			<column name='IMP_CODI' not-null='true' length='20' />
		</property>
		<property name='description' type='java.lang.String'>
			<column name='IMP_DESCR' not-null='false' length='50' />
		</property>
		<property name='local' type='java.lang.Boolean'>
			<column name='IMP_LOCPRI' not-null='false' length='1' />
		</property>
		<many-to-one name='server' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_IMPRES_IMP_IDMAQ'>
			<column name='IMP_IDMAQ' not-null='true'/>
		</many-to-one>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_IMPRES_IMP_TEN_ID'>
			<column name='IMP_TEN_ID' not-null='true'/>
		</many-to-one>
		<set name='groups' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_GRUIMP_GIM_IDIMP'>
				<column name='GIM_IDIMP'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.PrinterGroupEntityImpl'/>
		</set>
		<set name='users' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_USUIMP_UIM_IDIMP'>
				<column name='UIM_IDIMP'/>
			</key>
			<one-to-many class='com.soffid.iam.iga.model.UserPrinterEntityImpl'/>
		</set>
		<property name='createdOn' type='java.util.Date'>
			<column name='IMP_CREDAT' not-null='false' />
		</property>
		<property name='createdBy' type='java.lang.String'>
			<column name='IMP_CREUSE' not-null='false' />
		</property>
		<property name='updatedOn' type='java.util.Date'>
			<column name='IMP_UPDDAT' not-null='false' />
		</property>
		<property name='updatedBy' type='java.lang.String'>
			<column name='IMP_UPDUSE' not-null='false' />
		</property>
		<property name='deletedOn' type='java.util.Date'>
			<column name='IMP_DELDAT' not-null='false' />
		</property>
		<property name='deletedBy' type='java.lang.String'>
			<column name='IMP_DELUSE' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
