<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.ReconcileTriggerEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_RECPAR' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='RPA_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='trigger' type='com.soffid.iam.iga.api.SoffidObjectTriggerEnum'>
			<column name='RPA_TRIGGER' not-null='true' />
		</property>
		<property name='script' type='java.lang.String' lazy='true'>
			<column name='RPA_SCRIPT' not-null='true' length='20000' />
		</property>
		<property name='objectType' type='com.soffid.iam.iga.api.SoffidObjectTypeEnum'>
			<column name='RPA_TYPE' not-null='false' />
		</property>
		<many-to-one name='system' class='com.soffid.iam.iga.model.SystemEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_RECPAR_RPA_DIS_ID'>
			<column name='RPA_DIS_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
