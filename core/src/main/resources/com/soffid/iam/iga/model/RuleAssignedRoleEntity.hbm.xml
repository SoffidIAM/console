<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.RuleAssignedRoleEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_RULROL' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='RUR_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='bshDomainValueExpression' type='java.lang.String'>
			<column name='RUR_DOMEXP' not-null='false' />
		</property>
		<many-to-one name='rule' class='com.soffid.iam.iga.model.RuleEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_RULROL_RUR_RUL_ID'>
			<column name='RUR_RUL_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='role' class='com.soffid.iam.iga.model.RoleEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_RULROL_RUR_ROL_ID'>
			<column name='RUR_ROL_ID' not-null='true'/>
		</many-to-one>
		<property name='domainValue' type='java.lang.String'>
			<column name='RUR_DOMVAL' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
