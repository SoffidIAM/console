<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.UserGroupAttributeEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_UGRATT' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='UGA_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='value' type='java.lang.String'>
			<column name='UGA_VALOR' not-null='false' length='1024' />
		</property>
		<many-to-one name='userGroup' class='com.soffid.iam.iga.model.UserGroupEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_UGRATT_UGA_UGR_ID'>
			<column name='UGA_UGR_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='metadata' class='com.soffid.iam.iga.model.MetaDataEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_UGRATT_UGA_TDA_ID'>
			<column name='UGA_TDA_ID' not-null='true'/>
		</many-to-one>
		<property name='blobDataValue' type='java.sql.Blob' lazy='true'>
			<column name='UGA_BLOB' not-null='false' length='400000' />
		</property>
	</class>
</hibernate-mapping>
