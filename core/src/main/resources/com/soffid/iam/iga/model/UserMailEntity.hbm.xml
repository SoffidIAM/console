<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.UserMailEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_USULCO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='ULC_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='mailList' class='com.soffid.iam.iga.model.MailListEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_USULCO_ULC_IDLCO'>
			<column name='ULC_IDLCO' not-null='true'/>
		</many-to-one>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_USULCO_ULC_IDUSU'>
			<column name='ULC_IDUSU' not-null='true'/>
		</many-to-one>
		<property name='start' type='java.util.Date'>
			<column name='ULC_START' not-null='false' />
		</property>
		<property name='end' type='java.util.Date'>
			<column name='ULC_END' not-null='false' />
		</property>
		<property name='disabled' type='java.lang.Boolean'>
			<column name='ULC_DISABLED' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
