<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.UserPrinterEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_USUIMP' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='UIM_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='order' type='java.lang.Long'>
			<column name='UIM_ORDRE' not-null='false' />
		</property>
		<many-to-one name='printer' class='com.soffid.iam.iga.model.PrinterEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_USUIMP_UIM_IDIMP'>
			<column name='UIM_IDIMP' not-null='true'/>
		</many-to-one>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_USUIMP_UIM_IDUSU'>
			<column name='UIM_IDUSU' not-null='true'/>
		</many-to-one>
		<property name='createdOn' type='java.util.Date'>
			<column name='UIM_CREDAT' not-null='false' />
		</property>
		<property name='createdBy' type='java.lang.String'>
			<column name='UIM_CREUSE' not-null='false' />
		</property>
		<property name='updatedOn' type='java.util.Date'>
			<column name='UIM_UPDDAT' not-null='false' />
		</property>
		<property name='updatedBy' type='java.lang.String'>
			<column name='UIM_UPDUSE' not-null='false' />
		</property>
		<property name='deletedOn' type='java.util.Date'>
			<column name='UIM_DELDAT' not-null='false' />
		</property>
		<property name='deletedBy' type='java.lang.String'>
			<column name='UIM_DELUSE' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
