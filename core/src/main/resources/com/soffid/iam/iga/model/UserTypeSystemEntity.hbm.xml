<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.iga.model.UserTypeSystemEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_TIPDIS' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='TPD_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='system' class='com.soffid.iam.iga.model.SystemEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_TIPDIS_TPD_IDDIS'>
			<column name='TPD_IDDIS' not-null='true'/>
		</many-to-one>
		<many-to-one name='userType' class='com.soffid.iam.base.model.UserTypeEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_TIPDIS_TPD_TUS_ID'>
			<column name='TPD_TUS_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
