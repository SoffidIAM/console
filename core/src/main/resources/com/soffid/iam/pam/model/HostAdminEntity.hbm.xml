<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.pam.model.HostAdminEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_ADMMAQ' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='ADM_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='expirationDate' type='java.util.Date'>
			<column name='ADM_DATCAD' not-null='true' />
		</property>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_ADMMAQ_ADM_USUID'>
			<column name='ADM_USUID' not-null='true'/>
		</many-to-one>
		<many-to-one name='host' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_ADMMAQ_ADM_MAQID'>
			<column name='ADM_MAQID' not-null='true'/>
		</many-to-one>
		<property name='processWFID' type='java.lang.Long'>
			<column name='ADM_IDWF' not-null='false' />
		</property>
		<property name='requestDate' type='java.util.Date'>
			<column name='ADM_DATINI' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
