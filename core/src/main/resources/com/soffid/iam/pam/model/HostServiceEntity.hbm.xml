<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.pam.model.HostServiceEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_MAQSER' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='MAS_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='host' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_MAQSER_MAS_MAQ_ID'>
			<column name='MAS_MAQ_ID' not-null='true'/>
		</many-to-one>
		<property name='service' type='java.lang.String'>
			<column name='MAS_SERVICE' not-null='true' length='150' />
		</property>
		<property name='command' type='java.lang.String'>
			<column name='MAS_CMD' not-null='false' length='150' />
		</property>
		<property name='manual' type='boolean'>
			<column name='MAS_MANUAL' not-null='true' />
		</property>
		<many-to-one name='account' class='com.soffid.iam.base.model.AccountEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_MAQSER_MAS_ACC_ID'>
			<column name='MAS_ACC_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
