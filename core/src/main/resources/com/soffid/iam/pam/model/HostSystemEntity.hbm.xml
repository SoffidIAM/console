<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.pam.model.HostSystemEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_MAQDIS' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='MAD_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='host' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_MAQDIS_MAD_MAQ_ID'>
			<column name='MAD_MAQ_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='system' class='com.soffid.iam.iga.model.SystemEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_MAQDIS_MAQ_DIS_ID'>
			<column name='MAQ_DIS_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
