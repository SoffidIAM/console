<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.pam.model.NetworkDiscoveryAccountEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_XARACC' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='NDA_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='network' class='com.soffid.iam.am.model.NetworkEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_XARACC_NDA_XAR_ID'>
			<column name='NDA_XAR_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='account' class='com.soffid.iam.base.model.AccountEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_XARACC_NDA_ACC_ID'>
			<column name='NDA_ACC_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
