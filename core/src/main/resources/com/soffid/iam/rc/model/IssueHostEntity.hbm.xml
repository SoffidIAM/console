<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.rc.model.IssueHostEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_HOSEVE' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='HEV_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='issue' class='com.soffid.iam.rc.model.IssueEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_HOSEVE_HVE_EVE_ID'>
			<column name='HVE_EVE_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='host' class='com.soffid.iam.am.model.HostEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_HOSEVE_HVE_MAQ_ID'>
			<column name='HVE_MAQ_ID' not-null='false'/>
		</many-to-one>
		<property name='action' type='com.soffid.iam.pam.api.HostEventActionEnum'>
			<column name='HVE_ACTION' not-null='false' />
		</property>
		<property name='hostName' type='java.lang.String'>
			<column name='HVE_HOSNAM' not-null='false' />
		</property>
		<property name='hostIp' type='java.lang.String'>
			<column name='HVE_HOSIP' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
