<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.rc.model.IssueUserEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_USEEVE' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='UEV_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='issue' class='com.soffid.iam.rc.model.IssueEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_USEEVE_UVE_EVE_ID'>
			<column name='UVE_EVE_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='user' class='com.soffid.iam.base.model.UserEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_USEEVE_UVE_USU_ID'>
			<column name='UVE_USU_ID' not-null='false'/>
		</many-to-one>
		<property name='action' type='com.soffid.iam.iga.api.EventUserActionEnum'>
			<column name='UVE_ACTION' not-null='false' />
		</property>
		<property name='userName' type='java.lang.String'>
			<column name='UVE_USENAM' not-null='false' />
		</property>
		<property name='externalId' type='java.lang.String'>
			<column name='UVE_EXTID' not-null='false' />
		</property>
	</class>
</hibernate-mapping>
