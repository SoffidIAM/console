<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.rc.model.SoDRoleEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_SODROL' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='SOR_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='role' class='com.soffid.iam.iga.model.RoleEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SODROL_SOR_ROL_ID'>
			<column name='SOR_ROL_ID' not-null='true'/>
		</many-to-one>
		<many-to-one name='rule' class='com.soffid.iam.rc.model.SoDRuleEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SODROL_SOR_SOD_ID'>
			<column name='SOR_SOD_ID' not-null='true'/>
		</many-to-one>
		<set name='columns' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_SODMAT_SOD_SOR_ROW'>
				<column name='SOD_SOR_ROW'/>
			</key>
			<one-to-many class='com.soffid.iam.rc.model.SoDRuleMatrixEntityImpl'/>
		</set>
		<set name='rows' lazy='true' fetch='select' inverse='true'>
			<key foreign-key='SC_SODMAT_SOD_SOR_COL'>
				<column name='SOD_SOR_COL'/>
			</key>
			<one-to-many class='com.soffid.iam.rc.model.SoDRuleMatrixEntityImpl'/>
		</set>
	</class>
</hibernate-mapping>
