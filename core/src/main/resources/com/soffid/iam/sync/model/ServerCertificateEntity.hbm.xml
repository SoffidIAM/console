<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.sync.model.ServerCertificateEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_SRVCER' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='SCR_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<many-to-one name='server' class='com.soffid.iam.sync.model.ServerEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SRVCER_SCR_SER_ID'>
			<column name='SCR_SER_ID' not-null='true'/>
		</many-to-one>
		<property name='cert' type='org.springframework.orm.hibernate3.support.BlobByteArrayType' lazy='true'>
			<column name='SCR_CERT' not-null='true' length='64000' />
		</property>
		<property name='since' type='java.util.Date'>
			<column name='SCR_SINCE' not-null='true' />
		</property>
		<property name='until' type='java.util.Date'>
			<column name='SCR_UNTIL' not-null='true' />
		</property>
	</class>
</hibernate-mapping>
