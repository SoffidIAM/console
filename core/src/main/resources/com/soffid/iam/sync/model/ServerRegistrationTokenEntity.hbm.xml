<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-cascade='none' >
	<class name = 'com.soffid.iam.sync.model.ServerRegistrationTokenEntityImpl' dynamic-insert='false' dynamic-update='false' table='SC_SRRETO' >
		<id name='id' type='java.lang.Long' unsaved-value='null'>
			<column name='SRT_ID'/>
			<generator class='com.soffid.iam.model.identity.IdentityGenerator'/>
		</id>
		<property name='step' type='int'>
			<column name='SRT_STEP' not-null='true' />
		</property>
		<property name='token' type='java.lang.String'>
			<column name='SRT_TOKEN' not-null='true' length='100' />
		</property>
		<property name='expiration' type='java.util.Date'>
			<column name='SRT_EXPIR' not-null='true' />
		</property>
		<many-to-one name='tenant' class='com.soffid.iam.base.model.TenantEntityImpl' lazy='proxy' fetch='select' foreign-key='SC_SRRETO_SRT_TEN_ID'>
			<column name='SRT_TEN_ID' not-null='true'/>
		</many-to-one>
	</class>
</hibernate-mapping>
